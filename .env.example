# ============================================
# SIMKO — Environment Configuration
# ============================================

# --- Database ---
DATABASE_URL="mysql://root:password@localhost:3306/simko"

# --- NextAuth ---
AUTH_SECRET="your-secret-key-change-in-production"
AUTH_URL="http://localhost:3000"

# --- Firebase Admin (server-side push notifications) ---
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase Client (browser-side) ---
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123"
NEXT_PUBLIC_VAPID_KEY="your-vapid-public-key"

# --- Midtrans (Online Payment) ---
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"
# Uncomment for production:
# MIDTRANS_IS_PRODUCTION="true"

# --- Upstash Redis (serverless rate limiting) ---
# Required for serverless/Vercel deployments. If empty, falls back to
# in-memory rate limiting (safe only for single-server self-hosted).
UPSTASH_REDIS_REST_URL="https://your-region-xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"
# --- Environment Mode ---
# Set to "production" for live deployment, "development" for local testing.
# Controls Turnstile captcha, Midtrans environment, and other dev/prod behaviors.
NEXT_PUBLIC_APP_ENV=development

# --- Cloudflare Turnstile (Captcha) ---
# Test keys (always pass, no domain validation — for development via IP/localhost):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
#
# Production keys (get from https://dash.cloudflare.com/?to=/:account/turnstile):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
#   TURNSTILE_SECRET_KEY="0x4AAAAAAA..."
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Nginx ---
# NGINX_HTTP=80
# NGINX_HTTPS=443

# --- Docker MySQL Port (jangan bentrok dengan MySQL lokal) ---
# MYSQL_PORT=3307

# --- Sentry (Error Monitoring) ---
# Get your DSN from https://sentry.io
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/your-project"
# SENTRY_DSN — falls back to NEXT_PUBLIC_SENTRY_DSN for server-side if not set
# SENTRY_ORG="simko"
# SENTRY_PROJECT="simko-web"

# --- E2E Test Credentials ---
# Required to run Playwright tests. Use credentials from a seeded test DB.
# E2E_PENGURUS_EMAIL="pengurus@example.com"
# E2E_PENGURUS_PASSWORD="test123"
# E2E_ANGGOTA_EMAIL="anggota@example.com"
# E2E_ANGGOTA_PASSWORD="test123"

# --- Timezone ---
# e.g. "+07:00" for WIB (Asia/Jakarta)
TZ_OFFSET="+07:00"
